# コピーして local.env にし、値を入れる（local.env は git の管理外）
# 使い方：set -a; source local.env; set +a; ./gradlew bootRun

# ユーザープールのリージョンと ID（例：ap-southeast-2、ap-southeast-2_XXXXXXXXX）
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
# App Client の ID とシークレット
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# ユーザープールのドメイン（https:// から。末尾の / なし）
COGNITO_DOMAIN=https://xxxx.auth.ap-southeast-2.amazoncognito.com
